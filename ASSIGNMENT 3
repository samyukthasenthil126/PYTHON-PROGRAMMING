            ],
            "days": {"Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"}
        }
    }

    station_index = {}
    for train_no, details in timetable.items():
        for station_name, arrival, departure in details["stops"]:
            station_index.setdefault(station_name, []).append(train_no)

    def trains_at(station, day):
        matches = []
        for train_no in station_index.get(station, []):
            details = timetable[train_no]
            if day in details["days"] or "Daily" in details["days"]:
                for stop, arrival, departure in details["stops"]:
                    if stop == station:
                        matches.append((
                            departure, train_no, details["name"], arrival
                        ))
                        break
        return sorted(matches, key=lambda item: item[0])

    def trains_at_scan(station, day):
        matches = []
        for train_no, details in timetable.items():
            if day in details["days"] or "Daily" in details["days"]:
                for stop, arrival, departure in details["stops"]:
                    if stop == station:
                        matches.append((
                            departure, train_no, details["name"], arrival
                        ))
                        break
        return sorted(matches, key=lambda item: item[0])

