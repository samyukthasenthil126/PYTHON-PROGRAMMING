def clean_sensor_values(values):
    return [value for value in values if -50 <= value <= 50]


def question5():
    print("\n" + "=" * 65)
    print("QUESTION 5 – LIST COMPREHENSION: SENSOR READINGS")
    print("=" * 65)

    rng = random.Random(5)
    readings = [rng.randint(-60, 60) for _ in range(20)]

    # Method 1: for loop and append.
    valid_loop = []
    for celsius in readings:
        if -50 <= celsius <= 50:
            valid_loop.append(celsius)

    fahrenheit_loop = []
    for celsius in valid_loop:
        fahrenheit_loop.append(celsius * 9 / 5 + 32)

    # Method 2: list comprehension.
    valid_comp = [
        celsius for celsius in readings if -50 <= celsius <= 50
    ]
    fahrenheit_comp = [
        celsius * 9 / 5 + 32 for celsius in valid_comp
    ]

    # Method 3: filter and map.
    valid_map_filter = list(
        filter(lambda c: -50 <= c <= 50, readings)
    )
    fahrenheit_map = list(
        map(lambda c: c * 9 / 5 + 32, valid_map_filter)
    )

    alarms = [
        (minute + 1, celsius)
        for minute, celsius in enumerate(readings)
        if -50 <= celsius <= 50 and not (2 <= celsius <= 8)
    ]

    print("Original readings:", readings)
    print("Valid Celsius:", valid_loop)
    print("Valid Fahrenheit:",
          [round(value, 2) for value in fahrenheit_loop])
    print("Alarm minutes (minute, Celsius):", alarms)
    print("All three versions agree:",
          valid_loop == valid_comp == valid_map_filter and
          fahrenheit_loop == fahrenheit_comp == fahrenheit_map)

    fahrenheit_by_minute = {
        i + 1: celsius * 9 / 5 + 32
        for i, celsius in enumerate(readings)
        if -50 <= celsius <= 50
    }
    alarm_values = {
        celsius for celsius in readings
        if -50 <= celsius <= 50 and not (2 <= celsius <= 8)
    }

    print("Dictionary entries:", len(fahrenheit_by_minute))
    print("Distinct alarm temperatures:", sorted(alarm_values))

    generator = (
        celsius for celsius in readings if -50 <= celsius <= 50
    )
    valid_list = clean_sensor_values(readings)
    print("List object bytes:", sys.getsizeof(valid_list))
    print("Generator object bytes:", sys.getsizeof(generator))

    for n in (10000, 100000, 1000000):
        data = [rng.randint(-60, 60) for _ in range(n)]

        start = time.perf_counter()
        loop_result = []
        for celsius in data:
            if -50 <= celsius <= 50:
                loop_result.append(celsius)
        loop_time = time.perf_counter() - start

        start = time.perf_counter()
        comp_result = [
            celsius for celsius in data if -50 <= celsius <= 50
        ]
        comp_time = time.perf_counter() - start

        start = time.perf_counter()
        filter_result = list(
            filter(lambda c: -50 <= c <= 50, data)
        )
        filter_time = time.perf_counter() - start

        print(
            n, "loop:", round(loop_time, 6),
            "comprehension:", round(comp_time, 6),
            "filter:", round(filter_time, 6),
            "identical:", loop_result == comp_result == filter_result
        )

    print("Empty input:", clean_sensor_values([]))
    print("All valid:", clean_sensor_values([2, 5, 8]))
    print("All invalid:", clean_sensor_values([-51, 51, 100]))


