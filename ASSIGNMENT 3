def moving_average_running(values, window=7):
    """Calculate a moving average using a running sum."""
    if window <= 0 or len(values) < window:
        return []

    current = sum(values[:window])
    result = [current / float(window)]

    for i in range(window, len(values)):
        current += values[i] - values[i - window]
        result.append(current / float(window))

    return result


def question1():
    print("\n" + "=" * 65)
    print("QUESTION 1 – LISTS AND SLICING: DAILY RAINFALL RECORDS")
    print("=" * 65)

    rng = random.Random(10)
    readings = [rng.randint(0, 30) for _ in range(365)]

    weekly_totals = [
        sum(readings[i:i + 7])
        for i in range(0, len(readings), 7)
    ]

    highest = max(readings)
    lowest = min(readings)
    wettest_day = readings.index(highest) + 1
    driest_day = readings.index(lowest) + 1

    moving_average = [
        sum(readings[i:i + 7]) / 7.0
        for i in range(len(readings) - 6)
    ]

    dry_days = [
        (i + 1, value)
        for i, value in enumerate(readings)
        if value == 0
    ]

    print("Number of readings:", len(readings))
    print("First 5 readings:", readings[:5])
    print("First 5 weekly totals:", weekly_totals[:5])
    print("Number of weekly groups:", len(weekly_totals))
    print("Maximum rainfall:", highest, "mm on day", wettest_day)
    print("Minimum rainfall:", lowest, "mm on day", driest_day)
    print("Number of 7-day averages:", len(moving_average))
    print("First 3 moving averages:",
          [round(x, 2) for x in moving_average[:3]])
    print("Number of dry days:", len(dry_days))
    print("First 10 dry days:", dry_days[:10])

    running_result = moving_average_running(readings)
    print("Running-sum matches naive:",
          all(abs(a - b) < 1e-10
              for a, b in zip(running_result, moving_average)))

    print("readings[7:14]:", readings[7:14])
    print("readings[-7:]:", readings[-7:])
    print("readings[::7]:", readings[::7])

    print("Short input test:", moving_average_running([2, 4, 6]))
    print("Empty input test:", moving_average_running([]))


