def normalise_phone(phone):
    digits = re.sub(r"\D", "", phone or "")
    if len(digits) == 12 and digits.startswith("91"):
        digits = digits[2:]
    return digits


def normalise_name(name):
    name = (name or "").lower().strip()
    name = re.sub(r"^(dr|mr|mrs|ms)\.?\s+", "", name)
    return " ".join(name.split())


def merge_contacts(contact_lists):
    merged = {}

    for contacts in contact_lists:
        for contact in contacts:
            name = normalise_name(contact.get("name", ""))

            phones = {
                normalise_phone(phone)
                for phone in contact.get("phones", [])
            }
            phones.discard("")

            emails = {
                email.strip().lower()
                for email in contact.get("emails", [])
                if email and email.strip()
            }

            if phones:
                key = "phone:" + sorted(phones)[0]
            elif emails:
                key = "email:" + sorted(emails)[0]
            else:
                key = "name:" + name

            if key not in merged:
                merged[key] = {
                    "name": contact.get("name", "").strip(),
                    "phones": set(),
                    "emails": set()
                }

            merged[key]["phones"].update(phones)
            merged[key]["emails"].update(emails)

            if not merged[key]["name"] and contact.get("name"):
                merged[key]["name"] = contact["name"].strip()

    return merged


