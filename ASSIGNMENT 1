# Q3 - VEHICLE REGISTRATION NUMBER VALIDATOR USING STRING OPERATIONS
# ---------------------------------------------------------------------------

def normalise(text):
    return text.replace(" ", "").replace("-", "").upper()


def is_valid(registration):
    n = len(registration)
    if n not in (9, 10):
        return False
    series_length = n - 8
    state = registration[:2]
    district = registration[2:4]
    series = registration[4:4 + series_length]
    number = registration[-4:]
    return (state.isalpha() and district.isdigit()
            and series.isalpha() and number.isdigit())


def format_plate(registration):
    return " ".join([
        registration[:2], registration[2:4],
        registration[4:-4], registration[-4:]
    ])


def is_valid_re(registration):
    return re.fullmatch(
        r"[A-Z]{2}[0-9]{2}[A-Z]{1,2}[0-9]{4}", registration
    ) is not None


def run_q3():
    heading("Q3 - VEHICLE REGISTRATION NUMBER VALIDATOR")
    samples = [
        ("tn 09 ab 1234", True),
        ("TN-09-AB-1234", True),
        ("Tn09Ab1234", True),
        ("KA-01-M-0007", True),
        ("TN 9 AB 1234", False),
        ("TN09A12345", False)
    ]
    print("Input                 Normalised    Expected  Observed  Receipt")
    for raw, expected in samples:
        reg = normalise(raw)
        observed = is_valid(reg)
        receipt = format_plate(reg) if observed else "-"
        print(f"{raw:<21} {reg:<13} {str(expected):<9} "
              f"{str(observed):<9} {receipt}")

    print("\n--- Immutability and slicing ---")
    text_value = "tn09ab1234"
    print("text.upper() ->", text_value.upper(),
          "| text is still ->", text_value)
    try:
        text_value[0] = "T"
    except TypeError as error:
        print("TypeError:", error)

    for plate in ("TN09AB1234", "KA01M0007"):
        print(f"{plate} (length {len(plate)}): "
              f"s[-4:] = {plate[-4:]!r}, s[4:-4] = {plate[4:-4]!r}")

    print("\n--- Slicing vs regular expression ---")
    print("Both agree on all six inputs:",
          all(is_valid(normalise(raw)) == is_valid_re(normalise(raw))
              for raw, _ in samples))


# ---------------------------------------------------------------------------
# Q4 - BUILDING LONG TEXT: +, JOIN, F-STRING AND STRINGIO
# ---------------------------------------------------------------------------

def build_plus(parts):
    result = ""
    for part in parts:
        result += part + ";"
    return result


def build_join(parts):
    return ";".join(parts) + ";"


def build_fstring(number_of_lines):
    result = ""
    for i in range(number_of_lines):
        result += f"Item{i}:Rs{i % 50};"
    return result


def build_stringio(parts):
    buffer = io.StringIO()
    for part in parts:
        buffer.write(part)
        buffer.write(";")
    return buffer.getvalue()


def build_plus_defeated(parts):
    result, keep_reference = "", None
    for part in parts:
        result = result + part + ";"
        keep_reference = result
    return result


def average_time(function, *args, runs=3):
    total = 0.0
    for _ in range(runs):
        start = time.perf_counter()
        function(*args)
        total += time.perf_counter() - start
    return total / runs


def run_q4():
    heading("Q4 - BUILDING LONG TEXT: + OR JOIN()?")
    items = [f"Item{i}:Rs{i % 50}" for i in range(200_000)]

    plus_text = build_plus(items)
    join_text = build_join(items)
    print("same text:", plus_text == join_text, "| length:", len(join_text))

    print("\nAverage of 3 runs (seconds)")
    print(f"{'lines':>9} {'(a) +=':>12} {'(b) join':>12} "
          f"{'(c) f-string':>15} {'StringIO':>12}")
    for n in (1_000, 10_000, 200_000):
        parts = items[:n]
        times = (
            average_time(build_plus, parts),
            average_time(build_join, parts),
            average_time(build_fstring, n),
            average_time(build_stringio, parts)
        )
        print(f"{n:>9,} {times[0]:>12.6f} {times[1]:>12.6f} "
              f"{times[2]:>15.6f} {times[3]:>12.6f}")

    print("All four methods give the same text:",
          build_plus(items[:1000]) == build_join(items[:1000])
          == build_fstring(1000) == build_stringio(items[:1000]))

    print("\nShortcut-defeated test (single run; 1,000 and 10,000 lines)")
    print(f"{'lines':>9} {'+= active':>14} {'+= defeated':>16} {'join':>12}")
    for n in (1_000, 10_000):
        parts = items[:n]
        t1 = average_time(build_plus, parts, runs=1)
        t2 = average_time(build_plus_defeated, parts, runs=1)
        t3 = average_time(build_join, parts, runs=1)
        print(f"{n:>9,} {t1:>14.6f} {t2:>16.6f} {t3:>12.6f}")


