# Q1 - DECISIONS WITH MANY BOUNDARIES: STATE ELECTRICITY SUBSIDY
# ---------------------------------------------------------------------------

def subsidy_separate_if(units, ration_card, age80):
    """Developer's incorrect version: independent if statements."""
    result = []
    if units <= 100:
        result.append("Full")
    if units <= 200 and ration_card:       # Missing lower boundary
        result.append("Partial")
    if units > 200 and age80:
        result.append("Special")
    if units > 100 and age80:              # Overlaps with the previous rule
        result.append("Senior")
    return result or ["None"]


def subsidy_elif(units, ration_card, age80):
    """Correct version: exactly one decision."""
    if units <= 100:
        return "Full"
    elif 101 <= units <= 200 and ration_card:
        return "Partial"
    elif units > 200 and age80:
        return "Special"
    else:
        return "None"


def subsidy_match(units, ration_card, age80):
    """Python 3.10+ match-case version."""
    match units:
        case u if u <= 100:
            return "Full"
        case u if u <= 200:
            return "Partial" if ration_card else "None"
        case _:
            return "Special" if age80 else "None"


SUBSIDY_SLABS = [
    (100, lambda card, old: "Full"),
    (200, lambda card, old: "Partial" if card else "None"),
    (float("inf"), lambda card, old: "Special" if old else "None")
]


def subsidy_lookup(units, ration_card, age80):
    for upper_limit, decision in SUBSIDY_SLABS:
        if units <= upper_limit:
            return decision(ration_card, age80)
    return "None"


def run_q1():
    heading("Q1 - STATE ELECTRICITY SUBSIDY ELIGIBILITY")
    households = [
        (50, True, False), (100, True, False),
        (101, True, False), (101, False, False),
        (200, True, False), (200, False, True),
        (201, False, False), (201, False, True)
    ]
    predicted = ["Full", "Full", "Partial", "None",
                 "Partial", "None", "None", "Special"]

    print(f"{'#':<3}{'Units':>7}{'Card':>8}{'80+':>8} "
          f"{'Expected':<11}{'Separate-if':<20}{'if-elif':<11}"
          f"{'match':<11}{'lookup':<11}{'Check'}")
    differences = 0
    for i, (household, expected) in enumerate(zip(households, predicted), 1):
        separate = ", ".join(subsidy_separate_if(*household))
        corrected = subsidy_elif(*household)
        matched = subsidy_match(*household)
        looked_up = subsidy_lookup(*household)
        check = "OK" if corrected == matched == looked_up == expected else "MISMATCH"
        if separate != corrected:
            differences += 1
        print(f"{i:<3}{household[0]:>7}{str(household[1]):>8}"
              f"{str(household[2]):>8} {expected:<11}{separate:<20}"
              f"{corrected:<11}{matched:<11}{looked_up:<11}{check}")

    print("Chained comparison: 101 <= 101 <= 200 ->", 101 <= 101 <= 200)
    print("Chained comparison: 101 <= 201 <= 200 ->", 101 <= 201 <= 200)
    print("Households where separate-if differs from if-elif:", differences)


