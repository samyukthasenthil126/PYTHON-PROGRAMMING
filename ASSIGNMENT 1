# Q5 - FUNCTIONS, PARAMETERS AND SCOPE: COLLEGE CANTEEN
# ---------------------------------------------------------------------------

def add_item_buggy(item, order=[]):
    """Incorrect: the default list is created once and shared."""
    order.append(item)
    return order


def add_item(item, order=None):
    """Correct: create a fresh list whenever order is not supplied."""
    if order is None:
        order = []
    order.append(item)
    return order


def bill(order, prices, gst_rate=0.05, *, discount=0):
    subtotal = sum(prices[item] for item in order) - discount
    gst = round(subtotal * gst_rate, 2)
    return round(subtotal + gst, 2), gst


def make_order():
    """Closure: each call creates a private list for one customer."""
    order = []

    def add(item):
        order.append(item)
        return list(order)

    return add


def run_q5():
    heading("Q5 - FUNCTIONS, PARAMETERS AND SCOPE: CANTEEN ORDERS")
    print("--- Bug demonstration ---")
    print("First call:", add_item_buggy("Tea"))
    print("Second call:", add_item_buggy("Vada"))
    print("add_item_buggy.__defaults__ =", add_item_buggy.__defaults__)

    print("\n--- Three customers in sequence ---")
    customer_orders = [
        ["Tea", "Vada"], ["Samosa"], ["Tea"]
    ]
    for number, customer_items in enumerate(customer_orders, 1):
        order = None
        for item in customer_items:
            order = add_item(item, order)
        print(f"Customer {number}: {order}")

    prices = {"Tea": 10, "Vada": 15, "Samosa": 12}
    total, gst = bill(["Tea", "Vada"], prices)
    print("\n--- Returning two values ---")
    print("Customer 1 total, GST:", total, gst)
    print("Samosa with discount=2 (keyword):",
          bill(["Samosa"], prices, discount=2))
    print("Different rate by keyword gst_rate=0.12:",
          bill(["Tea"], prices, gst_rate=0.12))

    print("\n--- Scope: local, global, nonlocal ---")
    x = "global"

    def local_example():
        x = "local"
        return x

    def global_example():
        global GLOBAL_SCOPE_VALUE
        GLOBAL_SCOPE_VALUE = "changed by function"

    def counter():
        n = 0

        def increment():
            nonlocal n
            n += 1
            return n

        return increment

    print("local function returns", local_example(),
          "| module global x remains", x)
    GLOBAL_SCOPE_VALUE = "global"
    global_example()
    print("after global function:", GLOBAL_SCOPE_VALUE)
    count = counter()
    print("nonlocal counter:", count(), count(), count())

    local_count = 0

    def bad_scope_example():
        local_count += 1

    try:
        bad_scope_example()
    except UnboundLocalError as error:
        print("UnboundLocalError:", error)

    print("\n--- Alternative: closure ---")
    customer_a = make_order()
    customer_b = make_order()
    print("Customer A:", customer_a("Tea"), "then", customer_a("Vada"))
    print("Customer B:", customer_b("Samosa"))


# ---------------------------------------------------------------------------
# Q6 - RECURSION AND ITS LIMITS: TEMPLE STEPS
# ---------------------------------------------------------------------------

recursion_calls = 0


def ways_naive(n):
    """Plain recursive solution: one or two steps at a time."""
    global recursion_calls
    recursion_calls += 1
    if n <= 1:
        return 1
    return ways_naive(n - 1) + ways_naive(n - 2)


@lru_cache(maxsize=None)
def ways_memo(n):
    """Recursive solution with memoisation."""
    global recursion_calls
    recursion_calls += 1
    if n <= 1:
        return 1
    return ways_memo(n - 1) + ways_memo(n - 2)


def ways_loop(n):
    """Iterative solution using only the last two values."""
    if n < 0:
        raise ValueError("Number of steps cannot be negative.")
    previous, current = 1, 1
    for _ in range(n - 1):
        previous, current = current, previous + current
    return current


def run_q6():
    global recursion_calls
    heading("Q6 - RECURSION AND ITS LIMITS: TEMPLE STEPS")

    recursion_calls = 0
    print("naive:", ways_naive(25), "calls =", recursion_calls)
    ways_memo.cache_clear()
    recursion_calls = 0
    print("memo :", ways_memo(25), "calls =", recursion_calls)

    hand_values = [1, 2, 3, 5, 8, 13]
    print("\nn = 1..6 by hand :", hand_values)
    print("n = 1..6 program :", [ways_loop(n) for n in range(1, 7)])
    print("All three versions agree for n = 1..30:",
          all(ways_naive(n) == ways_memo(n) == ways_loop(n)
              for n in range(1, 31)))

    print("\n n plain calls memo calls")
    for n in (10, 20, 25, 30):
        recursion_calls = 0
        ways_naive(n)
        plain_calls = recursion_calls
        ways_memo.cache_clear()
        recursion_calls = 0
        ways_memo(n)
        memo_calls = recursion_calls
        print(f"{n:>3} {plain_calls:>12,} {memo_calls:>10}")

    recursion_calls = 0
    ways_naive(5)
    print("Calls for n = 5 (call tree):", recursion_calls)

    print("\nDefault recursion limit =", sys.getrecursionlimit())
    ways_memo.cache_clear()
    try:
        ways_memo(1000)
    except RecursionError as error:
        print("ways_memo(1000) -> RecursionError:", error)

    # The iterative version safely handles 1,000 steps without changing
    # Python's recursion limit.
    result = ways_loop(1000)
    print("Loop (default recursion limit):",
          len(str(result)), "digit answer")
    print("ways(1000) starts with:", str(result)[:20], "...")


