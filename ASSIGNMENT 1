# Q2 - OTP ATTEMPT COUNTER: WHILE, FOR, BREAK, CONTINUE, PASS AND RECURSION
# ---------------------------------------------------------------------------

CORRECT_OTP = "482913"


def verify_while(inputs):
    iterator = iter(inputs)
    attempts = 0
    while attempts < 3:
        try:
            otp = next(iterator).strip()
        except StopIteration:
            print(" No more test entries.")
            break
        if otp == "":
            print(" blank - ignored")
            continue
        attempts += 1
        if otp == CORRECT_OTP:
            print(" verified")
            break
        print(f" wrong ({attempts}/3)")
        pass
    else:
        print(" LOCKED for 30 minutes")


def verify_for(inputs):
    iterator = iter(inputs)
    for attempt in range(3):
        while True:
            try:
                otp = next(iterator).strip()
            except StopIteration:
                print(" No more test entries.")
                return
            if otp != "":
                break
            print(" blank - ignored")
        if otp == CORRECT_OTP:
            print(" verified")
            break
        print(f" wrong ({attempt + 1}/3)")
    else:
        print(" LOCKED for 30 minutes")


def verify_extended(inputs, security_ok):
    """Two additional attempts are granted once after a correct security answer."""
    iterator = iter(inputs)
    attempts, limit, extended = 0, 3, False
    while attempts < limit:
        try:
            otp = next(iterator).strip()
        except StopIteration:
            return f"test entries ended after {attempts} attempts"
        if otp == "":
            continue
        attempts += 1
        if otp == CORRECT_OTP:
            return f"verified on attempt {attempts}"
        if attempts == limit and not extended and security_ok:
            limit += 2
            extended = True
    return f"LOCKED after {attempts} attempts"


def verify_recursive(attempt, limit, iterator):
    if attempt > limit:
        return "LOCKED for 30 minutes"
    try:
        otp = next(iterator).strip()
    except StopIteration:
        return "test entries ended"
    if otp == "":
        return verify_recursive(attempt, limit, iterator)
    if otp == CORRECT_OTP:
        return "verified"
    return verify_recursive(attempt + 1, limit, iterator)


def run_q2():
    heading("Q2 - OTP VERIFICATION AT A BANK KIOSK (SIMULATION)")
    tests = {
        "success on second real attempt (blank between)": ["111111", "", "482913"],
        "three wrong attempts": ["1", "2", "3"]
    }
    for name, data in tests.items():
        print("\nwhile -", name)
        verify_while(data)
        print("for -", name)
        verify_for(data)
        print("recursive -", name, "->",
              verify_recursive(1, 3, iter(data)))

    print("\nChanged condition (two extra attempts):")
    print("4 wrong, 5th correct, security OK:",
          verify_extended(["1", "2", "3", "4", "482913"], True))
    print("5 wrong, security OK:",
          verify_extended(["1", "2", "3", "4", "5"], True))
    print("3 wrong, security answer wrong:",
          verify_extended(["1", "2", "3"], False))
    print("blanks between wrong attempts:",
          verify_extended(["1", "", "2", "", "3"], False))


