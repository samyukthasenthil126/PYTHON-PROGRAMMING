# Q7 - DIAGNOSE, REDESIGN AND VALIDATE THE TEMPLE-STEP PROGRAM
# ---------------------------------------------------------------------------

def ways_fast(n):
    """Bottom-up redesign: O(n) time and O(1) extra space."""
    if n < 0:
        raise ValueError("Number of steps cannot be negative.")
    previous, current = 1, 1
    for _ in range(n - 1):
        previous, current = current, previous + current
    return current


def run_q7():
    global recursion_calls
    heading("Q7 - DIAGNOSE, REDESIGN AND VALIDATE")

    print("Selected problem: plain recursive temple-step solution.")
    print("Bottleneck: repeated sub-problems cause exponential function calls.")
    print("Redesign: bottom-up loop stores only the previous two answers.")
    print("Prediction: O(phi^n) recursion becomes O(n) time and O(1) space.")

    print("\nValidation and performance comparison")
    print(f"{'n':>5} {'original calls':>16} {'new additions':>15} "
          f"{'original ms':>14} {'redesign ms':>14} {'same?':>8}")

    for n in (10, 20, 25, 30, 35):
        recursion_calls = 0
        start = time.perf_counter()
        original_result = ways_naive(n)
        original_ms = (time.perf_counter() - start) * 1000
        original_calls = recursion_calls

        start = time.perf_counter()
        redesigned_result = ways_fast(n)
        redesigned_ms = (time.perf_counter() - start) * 1000
        additions = max(0, n - 1)

        print(f"{n:>5} {original_calls:>16,} {additions:>15,} "
              f"{original_ms:>14.3f} {redesigned_ms:>14.3f} "
              f"{'YES' if original_result == redesigned_result else 'NO':>8}")

    print("\nFinal large-input validation")
    answer_1000 = ways_fast(1000)
    print("ways_fast(1000) has", len(str(answer_1000)), "digits.")
    print("First 20 digits:", str(answer_1000)[:20])
    print("Redesign agrees with Q6 loop:",
          ways_fast(1000) == ways_loop(1000))
    print("Conclusion: the loop avoids repeated calls and recursion-depth limits.")


