def profiling():

    start = time.perf_counter()

    rows = load_clean(RAW)

    end = time.perf_counter()

    print("\nPROFILING RESULTS")

    print("Valid rows:", len(rows))

    print("Execution time:",
          round(end - start, 6), "seconds")

    return rows


